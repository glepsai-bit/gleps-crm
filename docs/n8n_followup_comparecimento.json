      "id": "b2d3e4f5-6a7b-48c9-9d0e-2f3a4b5c6d7e",
      "name": "Log to Backend (opt)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1660, 320]
    }
  ],
