# ===========================================
# GLEPS CRM Backend - Environment Variables
# ===========================================

# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080

# Database (PostgreSQL)
DATABASE_URL=postgresql://gleps:gleps_secret@localhost:5432/gleps_crm?schema=public

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Google Calendar OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Prospecting / RapidAPI (Required for prospecting feature)
# Sem fallback hardcoded — se ausente, endpoints de prospecting retornam 503.
# Gere uma key em https://rapidapi.com/letscrape-6bRBa3QguO5/api/maps-data
RAPIDAPI_KEY=

# Encryption key for sensitive fields at rest (AES-256-GCM) — OBRIGATÓRIA em produção.
# Formato preferido: hex de 64 chars (32 bytes). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Usada para criptografar tokens OAuth do Google Calendar (e futuros segredos).
# NUNCA commitar a chave real. Em dev/test pode ficar vazia (operações que
# dependem dela falham com mensagem clara).
ENCRYPTION_KEY=

# Logging
LOG_LEVEL=debug

# Sentry (error tracking) — opcional, mas fortemente recomendado em prod.
# Se ausente, Sentry.init é pulado e o app continua funcionando normalmente.
# DSN é gerado no dashboard do Sentry para o projeto Node/Express.
SENTRY_DSN=

# Web Push Notifications (VAPID) — OPCIONAL, mas necessario pra notificar
# o navegador do agente quando chega mensagem inbound numa conversa dele.
# Gere um par com:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT precisa ser mailto:seu-email@dominio.com ou https://seu-site.
# Se qualquer uma das tres estiver vazia, o push service vira no-op silencioso
# e o hook do frontend nao pede permissao Notification.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
