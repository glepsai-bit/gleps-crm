  slaPolicy      SLAPolicy    @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)
  breachType     String       @map("breach_type") @db.VarChar(40) // first_response | resolution
  expectedAt     DateTime     @map("expected_at") @db.Timestamptz
