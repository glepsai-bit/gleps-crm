// ============================================
// DISPATCH BATCHES (Prospecting mass dispatch)
// ============================================
model DispatchBatch {
  id            String    @id @default(uuid()) @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  keyword       String?
  location      String?
  totalContacts Int       @default(0) @map("total_contacts")
  sentCount     Int       @default(0) @map("sent_count")
  failedCount   Int       @default(0) @map("failed_count")
  status        String    @default("running")
  delaySeconds  Int       @default(30) @map("delay_seconds")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // T-022 Sprint 2 — agendamento + origem unificada (manual + n8n + API)
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz
  source      String    @default("manual") @map("source") // manual | manual_scheduled | n8n | api
  triggerName String?   @map("trigger_name") @db.VarChar(120)
  metadata    Json?     @db.JsonB
  templateId  String?   @map("template_id") @db.Uuid
  inboxId     Int?      @map("inbox_id") // pra suporte Chatwoot legacy

  account  Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template WhatsappTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logs     DispatchLog[]

  @@index([accountId])
  @@index([scheduledAt, status])
  @@index([source])
  @@map("dispatch_batches")
}

