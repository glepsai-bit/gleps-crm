// GLEPS CRM Database Schema
// Multi-tenant CRM with Chatwoot integration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// SYSTEM SETTINGS (Singleton — configurações globais)
// ============================================
// SystemSettings: configurações globais do sistema (1 row only)
model SystemSettings {
  id                  String   @id @default("singleton") @db.VarChar(40)
  evolutionBaseUrl    String?  @map("evolution_base_url") @db.VarChar(500)
  evolutionApiKey     String?  @map("evolution_api_key") @db.VarChar(500)
  evolutionWebhookUrl String?  @map("evolution_webhook_url") @db.VarChar(500) // base do CRM pra Evolution chamar back
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

// ============================================
// ACCOUNTS (Multi-tenant)
// ============================================
model Account {
  id                     String        @id @default(uuid()) @db.Uuid
  nome                   String        @db.VarChar(255)
  timezone               String        @default("America/Sao_Paulo") @db.VarChar(100)
  plano                  String?       @db.VarChar(50)
  status                 AccountStatus @default(active)
  limiteUsuarios         Int           @default(10) @map("limite_usuarios")
  monthlyExtractionLimit Int?          @default(500) @map("monthly_extraction_limit")
  monthlyEmailLimit      Int?          @default(3000) @map("monthly_email_limit")
  dailyEmailLimit        Int?          @default(100) @map("daily_email_limit")

  // Chatwoot Integration
  chatwootBaseUrl   String? @map("chatwoot_base_url") @db.VarChar(500)
  chatwootAccountId String? @map("chatwoot_account_id") @db.VarChar(100)
  chatwootApiKey    String? @map("chatwoot_api_key") @db.VarChar(500)

  // Evolution API Integration (WhatsApp non-official) — T-022 FitPark
  // @deprecated Usar SystemSettings global. Estes campos permanecem como override
  // opcional per-account para clientes enterprise com instância Evolution dedicada.
  evolutionBaseUrl       String? @map("evolution_base_url") @db.VarChar(500)
  evolutionApiKey        String? @map("evolution_api_key") @db.VarChar(500)
  evolutionInstance      String? @map("evolution_instance") @db.VarChar(255)
  evolutionWebhookSecret String? @map("evolution_webhook_secret") @db.VarChar(500)

  // Google Calendar OAuth (stored in DB, not env vars)
  googleClientId     String? @map("google_client_id") @db.VarChar(500)
  googleClientSecret String? @map("google_client_secret") @db.VarChar(500)
  googleRedirectUri  String? @map("google_redirect_uri") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Email/AI Integration
  openaiApiKey      String? @map("openai_api_key") @db.VarChar(500)
  sendgridApiKey    String? @map("sendgrid_api_key") @db.VarChar(500)
  sendgridFromEmail String? @map("sendgrid_from_email") @db.VarChar(255)
  sendgridFromName  String? @map("sendgrid_from_name") @db.VarChar(255)
  emailBatchSize    Int     @default(100) @map("email_batch_size")
  emailDelayMs      Int     @default(500) @map("email_delay_ms")

  // Relations
  users                User[]
  contacts             Contact[]
  products             Product[]
  sales                Sale[]
  tags                 Tag[]
  funnels              Funnel[]
  calendarEvents       CalendarEvent[]
  events               Event[]
  googleCalendarTokens GoogleCalendarToken[]
  apiUsageLogs         ApiUsageLog[]
  dispatchBatches      DispatchBatch[]
  dispatchLogs         DispatchLog[]
  emailCadences        EmailCadence[]
  emailTemplates       EmailTemplate[]
  emailEnrollments     EmailEnrollment[]
  emailSends           EmailSend[]
  emailCampaigns       EmailCampaign[]
  emailInboxMessages   EmailInboxMessage[]
  emailAudiences       EmailAudience[]
  prospectingAudiences ProspectingAudience[]
  apiKeys              ApiKey[]
  whatsappTemplates    WhatsappTemplate[]
  webhookSubscriptions WebhookSubscription[]
  inboundIntegrations  InboundIntegration[]
  whatsappConsents     WhatsappConsent[]

  // T-022 Sprint 4 — Chat interno
  inboxes                    Inbox[]
  teams                      Team[]
  conversations              Conversation[]
  cannedResponses            CannedResponse[]
  customAttributeDefinitions CustomAttributeDefinition[]
  slaPolicies                SLAPolicy[]
  conversationCycles         ConversationCycle[]

  @@index([status])
  @@map("accounts")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(120)
  keyPrefix   String    @map("key_prefix") @db.VarChar(16)
  hashedKey   String    @map("hashed_key") @db.VarChar(255)
  scopes      String[]  @default([])
  createdById String?   @map("created_by_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([hashedKey])
  @@index([accountId])
  @@index([keyPrefix])
  @@map("api_keys")
}

// ============================================
// WEBHOOK OUTBOUND (T-022 Sprint 3)
// ============================================
model WebhookSubscription {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String    @db.VarChar(160)
  url            String    @db.VarChar(1000)
  events         String[]  @default([])
  secret         String    @db.VarChar(255) // HMAC SHA-256 secret
  active         Boolean   @default(true)
  lastDeliveryAt DateTime? @map("last_delivery_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  deliveries WebhookDelivery[]

  @@index([accountId])
  @@index([active])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      String              @map("event_type") @db.VarChar(120)
  payload        Json
  status         String              @default("pending") @db.VarChar(20) // pending | success | failed | dlq
  httpStatus     Int?                @map("http_status")
  responseBody   String?             @map("response_body") @db.Text
  attemptCount   Int                 @default(0) @map("attempt_count")
  nextRetryAt    DateTime?           @map("next_retry_at") @db.Timestamptz
  latencyMs      Int?                @map("latency_ms")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  completedAt    DateTime?           @map("completed_at") @db.Timestamptz

  @@index([subscriptionId])
  @@index([status, nextRetryAt])
  @@index([eventType])
  @@map("webhook_deliveries")
}

// ============================================
// WEBHOOK INBOUND (T-022 Sprint 3)
// ============================================
model InboundIntegration {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  slug      String   @db.VarChar(80) // identifica URL: /integrations/inbound/:accountId/:slug
  handler   String   @db.VarChar(80) // contact_upsert | tag_apply | campaign_trigger
  config    Json     @default("{}")
  secret    String?  @db.VarChar(255) // HMAC opcional para validar payload entrante
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([accountId, slug])
  @@index([accountId])
  @@map("inbound_integrations")
}

// ============================================
// COMPLIANCE: WHATSAPP CONSENT + OPT-OUT (T-022 Sprint 3)
// ============================================
model WhatsappConsent {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId String?  @map("contact_id") @db.Uuid // opcional, pode opt-out sem contato cadastrado
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  phone     String   @db.VarChar(30) // normalized 55DDDNUM
  status    String   @default("opted_in") @db.VarChar(20) // opted_in | opted_out
  source    String   @default("manual") @db.VarChar(40) // manual | auto_keyword | import | api
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([accountId, phone])
  @@index([accountId, status])
  @@index([phone])
  @@map("whatsapp_consents")
}

enum AccountStatus {
  active
  paused
  cancelled
}

// ============================================
// USERS
// ============================================
model User {
  id           String     @id @default(uuid()) @db.Uuid
  accountId    String?    @map("account_id") @db.Uuid
  nome         String     @db.VarChar(255)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         UserRole
  status       UserStatus @default(active)

  // Granular permissions (for agents)
  permissions String[] @default(["dashboard"])

  // Chatwoot Integration
  chatwootAgentId Int? @map("chatwoot_agent_id")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  account                  Account?           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sales                    Sale[]             @relation("SalesResponsavel")
  refundedSales            Sale[]             @relation("SalesRefundedBy")
  leadNotes                LeadNote[]
  calendarEvents           CalendarEvent[]
  actorEvents              Event[]            @relation("EventActor")
  refreshTokens            RefreshToken[]
  whatsappTemplatesCreated WhatsappTemplate[] @relation("WhatsappTemplateCreatedBy")

  // T-022 Sprint 4 — Chat interno
  conversationsAssigned      Conversation[]            @relation("ConversationAssignee")
  messagesSent               Message[]
  conversationParticipations ConversationParticipant[]
  conversationNotes          ConversationNote[]
  cannedResponsesCreated     CannedResponse[]
  teamMemberships            TeamMember[]
  mentions                   Mention[]
  readReceipts               ReadReceipt[]
  availability               AgentAvailability?
  cyclesResolved             ConversationCycle[]       @relation("CycleResolver")
  cyclesFirstResponded       ConversationCycle[]       @relation("CycleResponder")

  @@index([accountId])
  @@index([email])
  @@index([role])
  @@map("users")
}

enum UserRole {
  super_admin
  admin
  agent
}

enum UserStatus {
  active
  inactive
  suspended
}

// ============================================
// REFRESH TOKENS
// ============================================
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================
// CONTACTS (Leads)
// ============================================
model Contact {
  id        String         @id @default(uuid()) @db.Uuid
  accountId String         @map("account_id") @db.Uuid
  nome      String?        @db.VarChar(255)
  telefone  String?        @db.VarChar(50)
  email     String?        @db.VarChar(255)
  origem    ContactOrigin?

  // BUG-2: rastreabilidade da origem do `nome` pra evitar oscilação
  // (pushName WhatsApp vs nome digitado pelo agente). Quando 'manual',
  // webhooks NUNCA sobrescrevem; quando 'inbound', podem atualizar.
  // pushName guarda o último valor visto no WhatsApp pra auditoria.
  nameSource    ContactNameSource @default(inbound) @map("name_source")
  pushName      String?           @map("push_name") @db.VarChar(255)
  pushNameUpdatedAt DateTime?     @map("push_name_updated_at") @db.Timestamptz
  pushNameChangeCount Int         @default(0) @map("push_name_change_count")

  // Chatwoot Integration
  chatwootContactId      Int? @map("chatwoot_contact_id")
  chatwootConversationId Int? @map("chatwoot_conversation_id")

  // Segmentation
  nicho  String? @db.VarChar(255)
  cidade String? @db.VarChar(255)
  estado String? @db.VarChar(100)

  firstResolvedAt DateTime? @map("first_resolved_at") @db.Timestamptz

  // Follow-up
  followupCount  Int       @default(0) @map("followup_count")
  lastFollowupAt DateTime? @map("last_followup_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  account               Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sales                 Sale[]
  leadTags              LeadTag[]
  tagHistory            TagHistory[]
  leadNotes             LeadNote[]
  calendarEvents        CalendarEvent[]
  emailEnrollments      EmailEnrollment[]
  emailSends            EmailSend[]
  emailInboxMessages    EmailInboxMessage[]
  emailAudienceContacts EmailAudienceContact[]
  whatsappConsents      WhatsappConsent[]

  // T-022 Sprint 4 — Chat interno
  conversations Conversation[]

  // Garante dedupe de contato dentro do tenant — usado pelo
  // findOrCreateForCustomer (webhook Evolution faz retry agressivo).
  @@unique([accountId, telefone], name: "contacts_account_telefone_key")
  @@index([accountId])
  @@index([telefone])
  @@index([email])
  @@index([nicho])
  @@index([cidade])
  @@map("contacts")
}

enum ContactOrigin {
  whatsapp
  instagram
  site
  indicacao
  integration
  outro
}

// BUG-2: origem do Contact.nome — controla quem pode sobrescrever.
// 'manual'   = agente editou via UI; webhooks NÃO sobrescrevem.
// 'inbound'  = veio de pushName/notify do WhatsApp; webhooks podem atualizar.
// 'imported' = veio de CSV/integração; tratado como manual (não sobrescreve).
enum ContactNameSource {
  manual
  inbound
  imported
}

// ============================================
// FUNNELS
// ============================================
model Funnel {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  name      String  @db.VarChar(100)
  slug      String  @db.VarChar(100)
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tags    Tag[]

  @@unique([accountId, slug])
  @@index([accountId])
  @@map("funnels")
}

// ============================================
// TAGS (Kanban Stages)
// ============================================
model Tag {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  funnelId  String  @map("funnel_id") @db.Uuid
  name      String  @db.VarChar(100)
  slug      String  @db.VarChar(100)
  type      TagType
  color     String  @default("#6366F1") @db.VarChar(20)
  ordem     Int     @default(0)
  ativo     Boolean @default(true)

  // Chatwoot Integration
  chatwootLabelId Int? @map("chatwoot_label_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  funnel     Funnel       @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  leadTags   LeadTag[]
  tagHistory TagHistory[]

  // T-022 Sprint 4 — Chat interno
  conversationLabels ConversationLabel[]

  @@unique([accountId, slug])
  @@index([accountId])
  @@index([funnelId])
  @@index([type])
  @@map("tags")
}

enum TagType {
  stage
  operational
}

// ============================================
// LEAD_TAGS (Relationship)
// ============================================
model LeadTag {
  id            String        @id @default(uuid()) @db.Uuid
  contactId     String        @map("contact_id") @db.Uuid
  tagId         String        @map("tag_id") @db.Uuid
  appliedByType ActorType     @map("applied_by_type")
  appliedById   String?       @map("applied_by_id") @db.Uuid
  source        LeadTagSource

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([contactId])
  @@index([tagId])
  @@map("lead_tags")
}

enum ActorType {
  user
  agent_bot
  system
  external
}

enum LeadTagSource {
  kanban
  chatwoot
  system
  api
}

// ============================================
// TAG_HISTORY (Immutable Audit Log)
// ============================================
model TagHistory {
  id        String           @id @default(uuid()) @db.Uuid
  contactId String?          @map("contact_id") @db.Uuid
  tagId     String?          @map("tag_id") @db.Uuid
  action    TagHistoryAction
  actorType ActorType        @map("actor_type")
  actorId   String?          @map("actor_id") @db.Uuid
  source    LeadTagSource
  reason    String?

  // Snapshot data
  tagName     String? @map("tag_name") @db.VarChar(100)
  contactNome String? @map("contact_nome") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  tag     Tag?     @relation(fields: [tagId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([createdAt])
  @@map("tag_history")
}

enum TagHistoryAction {
  added
  removed
  tag_created
  tag_deleted
}

// ============================================
// PRODUCTS
// ============================================
model Product {
  id               String   @id @default(uuid()) @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  nome             String   @db.VarChar(255)
  valorPadrao      Decimal  @map("valor_padrao") @db.Decimal(10, 2)
  metodosPagamento String[] @default(["pix"]) @map("metodos_pagamento")
  conveniosAceitos String[] @default([]) @map("convenios_aceitos")
  ativo            Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@index([accountId])
  @@index([ativo])
  @@map("products")
}

// ============================================
// SALES
// ============================================
model Sale {
  id              String        @id @default(uuid()) @db.Uuid
  accountId       String        @map("account_id") @db.Uuid
  contactId       String        @map("contact_id") @db.Uuid
  valor           Decimal       @db.Decimal(10, 2)
  status          SaleStatus    @default(pending)
  metodoPagamento PaymentMethod @map("metodo_pagamento")
  convenioNome    String?       @map("convenio_nome") @db.VarChar(255)
  responsavelId   String        @map("responsavel_id") @db.Uuid
  isRecurring     Boolean       @default(false) @map("is_recurring")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  paidAt     DateTime? @map("paid_at") @db.Timestamptz
  refundedAt DateTime? @map("refunded_at") @db.Timestamptz

  // Refund metadata
  refundReason String? @map("refund_reason")
  refundedById String? @map("refunded_by") @db.Uuid

  // Relations
  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact     Contact    @relation(fields: [contactId], references: [id], onDelete: Restrict)
  responsavel User       @relation("SalesResponsavel", fields: [responsavelId], references: [id])
  refundedBy  User?      @relation("SalesRefundedBy", fields: [refundedById], references: [id])
  items       SaleItem[]

  @@index([accountId])
  @@index([contactId])
  @@index([status])
  @@index([responsavelId])
  @@index([createdAt])
  @@map("sales")
}

enum SaleStatus {
  pending
  paid
  refunded
  partial_refund
}

enum PaymentMethod {
  pix
  boleto
  debito
  credito
  dinheiro
  convenio
}

// ============================================
// SALE_ITEMS
// ============================================
model SaleItem {
  id            String    @id @default(uuid()) @db.Uuid
  saleId        String    @map("sale_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  quantidade    Int       @default(1)
  valorUnitario Decimal   @map("valor_unitario") @db.Decimal(10, 2)
  valorTotal    Decimal   @map("valor_total") @db.Decimal(10, 2)
  refunded      Boolean   @default(false)
  refundedAt    DateTime? @map("refunded_at") @db.Timestamptz
  refundReason  String?   @map("refund_reason")

  // Relations
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ============================================
// LEAD_NOTES
// ============================================
model LeadNote {
  id         String @id @default(uuid()) @db.Uuid
  contactId  String @map("contact_id") @db.Uuid
  authorId   String @map("author_id") @db.Uuid
  authorName String @map("author_name") @db.VarChar(255)
  content    String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([contactId])
  @@index([createdAt])
  @@map("lead_notes")
}

// ============================================
// EVENTS (Audit/Event Sourcing)
// ============================================
model Event {
  id         String     @id @default(uuid()) @db.Uuid
  accountId  String?    @map("account_id") @db.Uuid
  eventType  String     @map("event_type") @db.VarChar(100)
  actorType  ActorType? @map("actor_type")
  actorId    String?    @map("actor_id") @db.Uuid
  entityType String?    @map("entity_type") @db.VarChar(100)
  entityId   String?    @map("entity_id") @db.Uuid
  channel    String?    @db.VarChar(50)
  payload    Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  actor   User?    @relation("EventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([eventType])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("events")
}

// ============================================
// CALENDAR_EVENTS
// ============================================
model CalendarEvent {
  id          String              @id @default(uuid()) @db.Uuid
  accountId   String              @map("account_id") @db.Uuid
  title       String              @db.VarChar(255)
  startTime   DateTime            @map("start_time") @db.Timestamptz
  endTime     DateTime            @map("end_time") @db.Timestamptz
  type        CalendarEventType   @default(appointment)
  source      CalendarEventSource @default(crm)
  status      CalendarEventStatus @default(scheduled)
  location    String?             @db.VarChar(500)
  meetingLink String?             @map("meeting_link") @db.VarChar(500)
  contactId   String?             @map("contact_id") @db.Uuid
  notes       String?
  createdById String?             @map("created_by") @db.Uuid

  // Google Calendar sync
  googleEventId    String? @map("google_event_id") @db.VarChar(255)
  googleCalendarId String? @map("google_calendar_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  account   Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact   Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User?              @relation(fields: [createdById], references: [id])
  attendees CalendarAttendee[]

  @@index([accountId])
  @@index([startTime])
  @@index([googleEventId])
  @@map("calendar_events")
}

enum CalendarEventType {
  meeting
  appointment
  block
  other
}

enum CalendarEventSource {
  google
  crm
}

enum CalendarEventStatus {
  scheduled
  cancelled
  completed
}

