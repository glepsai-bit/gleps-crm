// ============================================
// EMAIL ENROLLMENTS
// ============================================
enum EmailEnrollmentStatus {
  active
  paused
  completed
  unsubscribed
  bounced

  @@map("email_enrollment_status")
}

model EmailEnrollment {
  id          String                @id @default(uuid()) @db.Uuid
  accountId   String                @map("account_id") @db.Uuid
  cadenceId   String                @map("cadence_id") @db.Uuid
  contactId   String                @map("contact_id") @db.Uuid
  currentStep Int                   @default(0) @map("current_step")
  status      EmailEnrollmentStatus @default(active)
  enrolledAt  DateTime              @default(now()) @map("enrolled_at") @db.Timestamptz
  nextSendAt  DateTime?             @map("next_send_at") @db.Timestamptz
  completedAt DateTime?             @map("completed_at") @db.Timestamptz
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz

  account       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cadence       EmailCadence        @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
