// ============================================
// CHAT INTERNO (T-022 Sprint 4) - Paridade Chatwoot
// ============================================

model Inbox {
  id                String   @id @default(uuid()) @db.Uuid
  accountId         String   @map("account_id") @db.Uuid
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name              String   @db.VarChar(120)
  channelType       String   @default("whatsapp") @map("channel_type") @db.VarChar(40) // whatsapp | email | facebook | instagram (futuro)
  evolutionInstance String?  @map("evolution_instance") @db.VarChar(120) // pra channelType=whatsapp
  greeting          String?  @db.Text
  businessHours     Json?    @map("business_hours") // {monday: {open: "09:00", close: "18:00"}, ...}
  defaultTeamId     String?  @map("default_team_id") @db.Uuid
  defaultTeam       Team?    @relation("DefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  conversations Conversation[]
  slaPolicies   SLAPolicy[]

  // Per-account uniqueness: nome de instance é único DENTRO da conta.
  // (Globalmente os nomes gerados já são únicos pela construção `acc-<8>-inb-<8>`,
  // mas a invariante semântica do app é per-account — bate com inboxService.create.)
  @@unique([accountId, evolutionInstance])
  @@index([accountId])
  @@index([active])
  @@map("inboxes")
}

model Team {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String   @db.VarChar(120)
  description     String?  @db.Text
  allowAutoAssign Boolean  @default(true) @map("allow_auto_assign")
  businessHours   Json?    @map("business_hours")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  members          TeamMember[]
  inboxesAsDefault Inbox[]        @relation("DefaultTeam")
  conversations    Conversation[]
  slaPolicies      SLAPolicy[]

  @@unique([accountId, name])
  @@index([accountId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") @db.VarChar(20) // member | leader
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Conversation {
  id               String     @id @default(uuid()) @db.Uuid
  accountId        String     @map("account_id") @db.Uuid
  account          Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inboxId          String     @map("inbox_id") @db.Uuid
  inbox            Inbox      @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  contactId        String?    @map("contact_id") @db.Uuid
  contact          Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status           String     @default("open") @db.VarChar(20) // open | pending | resolved | snoozed
  priority         String     @default("medium") @db.VarChar(20) // urgent | high | medium | low
  assigneeId       String?    @map("assignee_id") @db.Uuid
  assignee         User?      @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  teamId           String?    @map("team_id") @db.Uuid
  team             Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  slaPolicyId      String?    @map("sla_policy_id") @db.Uuid
  slaPolicy        SLAPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  snoozedUntil     DateTime?  @map("snoozed_until") @db.Timestamptz
  firstResponseAt  DateTime?  @map("first_response_at") @db.Timestamptz
  resolvedAt       DateTime?  @map("resolved_at") @db.Timestamptz
  resolvedBy       String?    @map("resolved_by") @db.VarChar(20) // ai | human | timeout
  externalId       String?    @map("external_id") @db.VarChar(120) // remoteJid do WhatsApp
  customAttributes Json?      @default("{}") @map("custom_attributes")
  unreadCount      Int        @default(0) @map("unread_count")
  openCycleId      String?    @map("open_cycle_id") @db.Uuid // ciclo ativo (open) OU null
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  messages     Message[]
  labels       ConversationLabel[]
  participants ConversationParticipant[]
  notes        ConversationNote[]
  mentions     Mention[]
  slaBreaches  SLABreach[]
  cycles       ConversationCycle[]

  // SE-H1: dedupe de conversa por remoteJid dentro do inbox — usado pelo
  // findOrCreateForCustomer (webhook Evolution faz retry agressivo).
  // Implementado como índice ÚNICO PARCIAL (WHERE external_id IS NOT NULL) via
  // migration 0028_conversation_external_unique — Prisma não suporta partial
  // unique no schema, então o índice fica fora do model mas o Postgres garante.
  // Conversas sem externalId (ex: criadas manualmente) seguem livres pra duplicar.
  @@index([accountId])
  @@index([inboxId])
  @@index([contactId])
  @@index([assigneeId])
  @@index([teamId])
  @@index([status])
  @@index([externalId])
  @@map("conversations")
}

model ConversationCycle {
  id                    String       @id @default(uuid()) @db.Uuid
  conversationId        String       @map("conversation_id") @db.Uuid
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  accountId             String       @map("account_id") @db.Uuid
  account               Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  openedAt              DateTime     @default(now()) @map("opened_at") @db.Timestamptz
  resolvedAt            DateTime?    @map("resolved_at") @db.Timestamptz
  resolvedBy            String?      @map("resolved_by") @db.VarChar(20)
  resolvedByUserId      String?      @map("resolved_by_user_id") @db.Uuid
  resolvedByUser        User?        @relation("CycleResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  firstResponseAt       DateTime?    @map("first_response_at") @db.Timestamptz
  firstResponseByUserId String?      @map("first_response_by_user_id") @db.Uuid
  firstResponseByUser   User?        @relation("CycleResponder", fields: [firstResponseByUserId], references: [id], onDelete: SetNull)
  customerMessagesCount Int          @default(0) @map("customer_messages_count")
  agentMessagesCount    Int          @default(0) @map("agent_messages_count")
  durationSec           Int?         @map("duration_sec")
  slaBreached           Boolean      @default(false) @map("sla_breached")
  slaBreachedAt         DateTime?    @map("sla_breached_at") @db.Timestamptz
  snapshot              Json? // priority, team, assignee, labels no momento da resolucao

  @@index([accountId, resolvedAt])
  @@index([conversationId])
  @@index([resolvedBy])
  @@index([accountId, openedAt])
  @@map("conversation_cycles")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String       @map("sender_type") @db.VarChar(20) // customer | agent | ai_bot | system | integration
  senderId       String?      @map("sender_id") @db.Uuid // userId quando agent; null para customer/system
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  content        String?      @db.Text
  contentType    String       @default("text") @map("content_type") @db.VarChar(40) // text | media | audio | document | system_note | template
  isPrivate      Boolean      @default(false) @map("is_private") // notas internas
  status         String       @default("sent") @db.VarChar(20) // sending | sent | delivered | read | failed
  externalId     String?      @map("external_id") @db.VarChar(120) // messageId do Evolution
  replyToId      String?      @map("reply_to_id") @db.Uuid
  replyTo        Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReply")
  deliveredAt    DateTime?    @map("delivered_at") @db.Timestamptz
  readAt         DateTime?    @map("read_at") @db.Timestamptz
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  attachments  Attachment[]
  readReceipts ReadReceipt[]

  // SE-H2: idempotência de Evolution messages.upsert. Postgres permite múltiplos NULLs
  // num UNIQUE comum, então mensagens sem externalId (ex: notas internas) seguem livres,
  // mas duas mensagens com mesmo (conversationId, externalId) levantam P2002 — que o
  // controller trata como skip silencioso. Sem esse unique a janela de retry da Evolution
  // duplicava Messages, inflava unreadCount e disparava webhookOutbound 2x.
  @@unique([conversationId, externalId])
  @@index([conversationId])
  @@index([senderType])
  @@index([externalId])
  @@index([createdAt])
  @@map("messages")
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileType     String   @map("file_type") @db.VarChar(40) // image | video | audio | document
  // fileUrl: URL servível pelo frontend. Após baixar a mídia da Evolution,
  // passa a ser '/api/attachments/<id>' (proxy autenticado). Em rows legadas
  // pode estar a URL original (Evolution) — preservada também em sourceUrl.
  fileUrl      String   @map("file_url") @db.VarChar(2000)
  fileSize     Int?     @map("file_size")
  fileName     String?  @map("file_name") @db.VarChar(255)
  mimeType     String?  @map("mime_type") @db.VarChar(120)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(2000)
  duration     Int? // segundos pra audio/video
  // Bug A: storagePath = caminho relativo a backend/uploads onde a mídia foi
  // materializada (ex.: '<accountId>/<id>.ogg'). storageStatus = pending |
  // downloaded | failed. sourceUrl = URL original da Evolution pra retry/fallback.
  storagePath   String?  @map("storage_path") @db.VarChar(500)
  storageStatus String?  @default("pending") @map("storage_status") @db.VarChar(20)
  sourceUrl     String?  @map("source_url") @db.VarChar(2000)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([messageId])
  @@index([storageStatus])
  @@map("attachments")
}

model ConversationLabel {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
