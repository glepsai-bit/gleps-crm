# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment / secrets (NUNCA commitar — contêm chaves reais)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Uploads runtime (midias do usuario — atachments, audios warmup, etc).
# Persistido em volume em prod; nunca versionado.
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/warmup/
backend/uploads/warmup/*
!backend/uploads/warmup/.gitkeep
!backend/uploads/warmup/audio/
!backend/uploads/warmup/sticker/
!backend/uploads/warmup/image/
backend/uploads/warmup/audio/*
backend/uploads/warmup/sticker/*
backend/uploads/warmup/image/*
!backend/uploads/warmup/audio/.gitkeep
!backend/uploads/warmup/sticker/.gitkeep
!backend/uploads/warmup/image/.gitkeep

# Pista B — Postgres backups (dumps sql.gz). Nunca versionar (dados dos clientes).
# Mount definido em docker-compose.yml -> backend.volumes -> ./backups:/app/backups
backups/*
!backups/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
