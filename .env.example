# ===========================================
# GLEPS CRM - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# Application Settings
# ===========================================
NODE_ENV=production
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080

# ===========================================
# Database (PostgreSQL)
# ===========================================
DB_USER=gleps
DB_PASSWORD=your_secure_password_here
DB_NAME=gleps_crm
DB_PORT=5432

# Full connection string (generated from above or custom)
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public

# ===========================================
# JWT Authentication
# IMPORTANT: Generate secure random strings!
# Use: openssl rand -base64 32
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# ===========================================
# Security
# ===========================================
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===========================================
# Google Calendar OAuth (Optional)
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/calendar/google/callback

# ===========================================
# Logging
# Options: debug, info, warn, error
# ===========================================
LOG_LEVEL=info

# ===========================================
# Sentry (error tracking) — frontend
# Opcional, mas fortemente recomendado em prod.
# Se ausente, Sentry.init é pulado e o app continua funcionando normalmente.
# DSN gerado no dashboard do Sentry para o projeto React/Browser.
# ===========================================
VITE_SENTRY_DSN=

# ===========================================
# Web Push Notifications (VAPID) — backend
# Opcional, mas necessario pra notificar o navegador do agente quando chega
# mensagem inbound numa conversa dele.
# Gere um par com: npx web-push generate-vapid-keys
# VAPID_SUBJECT precisa ser mailto:seu-email@dominio.com ou https://seu-site.
# Se qualquer uma das tres estiver vazia, o push service vira no-op silencioso.
# Consumido pelo container do backend (nao pelo Vite/frontend — a chave publica
# eh servida via GET /api/push/vapid-public quando configurada).
# ===========================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
