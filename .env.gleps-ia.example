# ============================================
# GLEPS IA CRM - Template de variaveis de ambiente
# ============================================
# Copie este arquivo para .env.gleps-ia e ajuste os valores.
# NUNCA commite o .env.gleps-ia (esta no .gitignore via .env).
#
# REGRA DE OURO: NADA aqui pode coincidir com o stack GoodLeads
# (DB, JWT secrets, dominio). Isolamento total.
# ============================================

# ---------- BANCO DE DADOS (Postgres proprio do Gleps IA) ----------
# Trocar TODOS os valores GLEPS_IA_* por valores reais antes de subir.
# Senha forte recomendada: openssl rand -base64 24
DB_USER=GLEPS_IA_db_user
DB_PASSWORD=GLEPS_IA_db_password_change_me
DB_NAME=GLEPS_IA_crm

# ---------- JWT / AUTH ----------
# OBRIGATORIO: gerar valores NOVOS, diferentes do GoodLeads.
# Comando: openssl rand -base64 32
# Se reutilizar o secret do GoodLeads, tokens podem cruzar entre stacks.
JWT_SECRET=GERE_COM_openssl_rand_base64_32_DIFERENTE_DO_GOODLEADS
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=GERE_COM_openssl_rand_base64_32_DIFERENTE_DO_GOODLEADS
REFRESH_TOKEN_EXPIRES_IN=7d

# ---------- DOMINIO / CORS ----------
# Frontend do Gleps IA vive em crm.gleps.com.br.
# CORS_ORIGINS aceita lista separada por virgula (sem espaços).
FRONTEND_URL=https://crm.gleps.com.br
CORS_ORIGINS=https://crm.gleps.com.br

# ---------- SEED INICIAL ----------
# true = na primeira subida, cria account raiz + super_admin do Gleps IA.
# Apos primeiro deploy bem-sucedido, mudar para false para evitar re-seed.
RUN_SEED=true

# ---------- AMBIENTE ----------
NODE_ENV=production
LOG_LEVEL=info

# ---------- BCRYPT / RATE LIMIT (opcionais, ja tem default) ----------
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------- INTEGRACOES (preencher conforme contrato do cliente) ----------
# Estas credenciais sao da conta-mae do Gleps IA. Tenants configuram as
# proprias via UI Super Admin.
CHATWOOT_WEBHOOK_SECRET=
RAPIDAPI_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
